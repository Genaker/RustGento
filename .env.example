MYSQL_USER=magento
MYSQL_PASS=magento
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=magento

# Only read by `gogento-import --driver postgres` (see the README's
# "Postgres synthetic import" section) -- the server and every other binary
# are MySQL-only.
POSTGRES_USER=magento
POSTGRES_PASS=magento
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=magento

API_USER=admin
API_PASS=secret
AUTH_TYPE=basic

PORT=8080
RUST_LOG=info
PRODUCT_FLAT_CACHE=off

MAGENTO_CRYPT_KEY=
